#include <SPI.h>
#include <Ethernet.h>

byte mac[] = { 0xDE, 0xAD, 0xBE, 0xEF, 0xFE, 0xED };
IPAddress ip();
EthernetServer server(502);

void setup() {
  Serial.begin(9600);
  Ethernet.begin(mac, ip);
  server.begin();
  
  pinMode(D0, OUTPUT);
  digitalWrite(D0, LOW);
}

void loop() {
  EthernetClient client = server.available();
  if (client) {
    while (client.connected()) {
      if (client.available()) {
        char c = client.read();
        
        if (c == '1') {
          digitalWrite(D0, HIGH); // Motor AN
          client.println("OK: Motor AN");
        } 
        else if (c == '0') {
          digitalWrite(D0, LOW);  // Motor AUS
          client.println("OK: Motor AUS");
        }
      }
    }
    client.stop();
  }
}
